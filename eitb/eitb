#!/usr/bin/env bash
#
# eitb -- launcher for the compiled eitb CLI. Compiles the TypeScript
# sources on first use (or after a clean), then forwards every
# argument to the Node.js entry point.

set -eu
set -o pipefail

cd "$(dirname "$0")/.."

if [[ ! -f dist-eitb/eitb/eitb.js ]]; then
    npm run --silent eitb:build
fi

exec node dist-eitb/eitb/eitb.js "$@"
